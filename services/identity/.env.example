# Локально піднімається через docker compose up postgres rabbitmq
DATABASE_URL=postgresql+asyncpg://baymeister:baymeister@localhost:5432/identity

# Якщо не задано — події пишуться в лог замість шини.
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Приватний RSA-ключ для підпису токенів (PEM). Без нього сервіс генерує
# тимчасовий ключ при старті — зручно локально, але після перезапуску всі
# видані токени стають недійсними. У проді ключ обовʼязковий.
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.pem
# JWT_PRIVATE_KEY_FILE=./jwt.pem

# Скільки живе токен. 8 годин — одна зміна.
# ACCESS_TOKEN_TTL_SECONDS=28800

# Перший власник. Створюється командою `uv run python -m app.bootstrap`,
# тільки якщо в базі ще немає жодного користувача.
BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOOTSTRAP_OWNER_PASSWORD=change-me-please
BOOTSTRAP_OWNER_NAME=Власник

PORT=8002
