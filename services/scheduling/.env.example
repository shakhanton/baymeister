# Локально піднімається через docker compose up postgres rabbitmq
DATABASE_URL=postgresql+asyncpg://baymeister:baymeister@localhost:5432/scheduling

# Якщо не задано — події пишуться в лог, а копії клієнта й авто не оновлюються.
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Сусідні сервіси напряму, всередині мережі.
CUSTOMERS_URL=http://localhost:8001
VEHICLES_URL=http://localhost:8003

# Пояс для годин у повідомленнях («зайнятий з 10:00»). Дані — завжди UTC.
# BUSINESS_TIMEZONE=Europe/Kyiv

PORT=8005
